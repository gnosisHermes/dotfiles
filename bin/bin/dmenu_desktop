#!/usr/bin/env bash

chosen=$(find /usr/share/applications ~/.local/share/applications -name "*.desktop" 2>/dev/null | while read -r file; do
    name=$(grep -m 1 '^Name=' "$file" | cut -d= -f2-)
    [ -n "$name" ] && echo "$name | $file"
done | sort -u | dmenu -i -c -l 15 | cut -d'|' -f2 | xargs)

gio launch "$chosen";

