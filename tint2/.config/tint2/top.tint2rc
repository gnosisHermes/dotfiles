#-------------------------------------
# Executor 1
execp = new
execp_command = vol=$(pamixer --get-volume); muted=$(pamixer --get-mute); if [ "$muted" = "true" ]; then printf "<span foreground='#888888'>muted</span>"; else printf "<span foreground='#888888'>VOL</span> <span foreground='#ff33cc'>%s%%</span>" "$vol"; fi
execp_interval = 0
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 0
execp_markup = 1
execp_monitor = all
execp_tooltip = 
execp_lclick_command = pamixer -t
execp_rclick_command = 
execp_mclick_command = 
execp_uwheel_command = pamixer -i 5
execp_dwheel_command = pamixer -d 5
execp_font = Terminus 12
execp_font_color = #613583 100
execp_padding = 6 0
execp_background_id = 0
execp_centered = 0
execp_icon_w = 0
execp_icon_h = 0

#-------------------------------------
# Executor 2
execp = new
execp_command = free | awk '/Mem/{printf "<span foreground=\x27#888888\x27>RAM</span> <span foreground=\x27#ff33cc\x27>%.0f%%</span>", $3/$2*100}'
execp_interval = 5
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 0
execp_markup = 1
execp_monitor = all
execp_lclick_command = 
execp_rclick_command = 
execp_mclick_command = 
execp_uwheel_command = 
execp_dwheel_command = 
execp_font = Terminus 12
execp_font_color = #613583 100
execp_padding = 6 0
execp_background_id = 0
execp_centered = 0
execp_icon_w = 0
execp_icon_h = 0

#-------------------------------------
# Executor 3
execp = new
execp_command = top -bn1 | awk -F'[, ]+' '/Cpu/{printf "<span foreground=\x27#888888\x27>CPU</span> <span foreground=\x27#ff33cc\x27>%d%%</span>", $2}'
execp_interval = 2
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 0
execp_markup = 1
execp_monitor = all
execp_tooltip = 
execp_lclick_command = 
execp_rclick_command = 
execp_mclick_command = 
execp_uwheel_command = 
execp_dwheel_command = 
execp_font = Terminus 12
execp_font_color = #613583 100
execp_padding = 6 0
execp_background_id = 0
execp_centered = 0
execp_icon_w = 0
execp_icon_h = 0

#-------------------------------------
# Executor 4
execp = new
execp_command = ip=$(ip -4 addr show eth0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}'); printf "<span foreground='#888888'>eth0</span> <span foreground='#ff33cc'>%s</span>" "$ip"
execp_interval = 10
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 0
execp_markup = 1
execp_monitor = all
execp_lclick_command = 
execp_rclick_command = 
execp_mclick_command = 
execp_uwheel_command = 
execp_dwheel_command = 
execp_font = Terminus 12
execp_font_color = #613583 100
execp_padding = 6 6
execp_background_id = 0
execp_centered = 0
execp_icon_w = 0
execp_icon_h = 0

