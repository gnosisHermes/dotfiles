#-------------------------------------
# Gradients
#-------------------------------------
# Backgrounds
# Background 1: Inactive taskbar
rounded = 0
border_width = 0
border_sides = TBLR
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #00f021 0
border_color = #000000 0
background_color_hover = #000000 0
border_color_hover = #000000 0
background_color_pressed = #000000 0
border_color_pressed = #000000 0

# Background 2: 
rounded = 0
border_width = 1
border_sides = B
border_content_tint_weight = 3
background_content_tint_weight = 100
background_color = #0f0214 100
border_color = #613583 100
background_color_hover = #0f0214 100
border_color_hover = #613583 100
background_color_pressed = #0f0214 100
border_color_pressed = #613583 100

# Background 3: Panel
rounded = 0
border_width = 1
border_sides = B
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #0f0214 100
border_color = #613583 100
background_color_hover = #0f0214 100
border_color_hover = #613583 100
background_color_pressed = #0f0214 100
border_color_pressed = #613583 100

#-------------------------------------
# Panel
panel_items = T:E:S:E:E:E::C
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 0 2 1
panel_background_id = 3
wm_menu = 0
panel_dock = 0
panel_pivot_struts = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0
autohide_height = 1
strut_policy = follow_size
panel_window_name = tint2 - bar
disable_transparency = 0
mouse_effects = 0
font_shadow = 1
mouse_hover_icon_asb = 100 0 12
mouse_pressed_icon_asb = 100 3 0
scale_relative_to_dpi = 0
scale_relative_to_screen_height = 0

#-------------------------------------
# Taskbar
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 0 0 0
taskbar_background_id = 1
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_hide_inactive_tasks = 1
taskbar_hide_different_monitor = 1
taskbar_hide_different_desktop = 1
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 3 0
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_name_font = Terminus 12
taskbar_name_font_color = #888888 100
taskbar_name_active_font_color = #613583 100
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = center

#-------------------------------------
# Task
task_text = 0
task_icon = 0
task_centered = 0
urgent_nb_of_blink = 0
task_maximum_size = 1 1
task_padding = 0 0 0
task_tooltip = 0
task_thumbnail = 0
task_thumbnail_size = 8
task_font_color = #ffffff 0
mouse_left = none
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none

#-------------------------------------
# System tray (notification area)
systray_padding = 0 4 0
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 16
systray_icon_asb = 99 0 0
systray_monitor = 1
systray_name_filter = 

